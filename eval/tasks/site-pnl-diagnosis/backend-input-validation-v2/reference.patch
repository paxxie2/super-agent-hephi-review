-class CreateDiagnosisRequest(BaseModel):
+class StrictRequestModel(BaseModel):
+    """请求体基类：拒绝未知字段，并把未知字段名写进可读的中文错误。
+
+    未知字段的 pydantic 默认错误不携带字段名（loc 只有 ``body``），调用方无法定位
+    拼错的字段；这里用 before-validator 显式列出未知字段，让 400 响应能指向字段。
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    @model_validator(mode="before")
+    @classmethod
+    def _reject_unknown_fields(cls, data: Any) -> Any:
+        if isinstance(data, dict):
+            extras = sorted(set(data) - set(cls.model_fields))
+            if extras:
+                raise ValueError("不支持的字段: " + ", ".join(extras))
+        return data
+
+
+class CreateDiagnosisRequest(StrictRequestModel):
     siteId: str
     startDate: DateStr
     endDate: DateStr
