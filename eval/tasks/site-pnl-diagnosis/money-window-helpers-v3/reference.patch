 def datetime_with_tz(date_str: str, time_str: str = "00:00:00") -> datetime:
     """构造 Asia/Shanghai 时区（+08:00）的 datetime，用于比较业务时间。"""
     return datetime.fromisoformat(f"{date_str}T{time_str}+08:00")
+
+
+def clamp_window(start: str, end: str, max_days: int) -> tuple[str, str]:
+    """把窗口截断到不超过 ``max_days`` 天（从 start 起算，含首尾）。
+
+    - ``max_days`` 必须是 >= 1 的整数，否则抛 ``ValueError``；
+    - 窗口已经不超过上限时原样返回；
+    - ``start > end`` 时退化为单日 ``(start, start)``。
+    """
+    if not isinstance(max_days, int) or isinstance(max_days, bool) or max_days < 1:
+        raise ValueError("max_days must be a positive integer")
+    start_date = parse_date(start)
+    end_date = parse_date(end)
+    if start_date > end_date:
+        return start, start
+    if (end_date - start_date).days + 1 <= max_days:
+        return start, end
+    clamped_end = start_date + timedelta(days=max_days - 1)
+    return start, clamped_end.isoformat()
